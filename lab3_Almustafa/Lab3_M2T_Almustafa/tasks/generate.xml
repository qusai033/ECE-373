<?xml version="1.0" encoding="UTF-8"?>
<project default="generate" name="Lab3_M2T_Almustafa">
    <property name="ECLIPSE_HOME" value="../../../eclipse/java-2022-06/Eclipse.app/Contents/Eclipse"/>
    <property name="ECLIPSE_WORKSPACE" value="../.."/>

    <!-- The classpath with only the dependencies used by the project -->
    <path id="Lab3_M2T_Almustafa.libraryclasspath">
        <pathelement location="${ECLIPSE_WORKSPACE}/Lab3_M2T_Almustafa/bin"/>
    </path>

    <path id="Lab3_M2T_Almustafa.classpath">
        <path refid="Lab3_M2T_Almustafa.libraryclasspath"/>
    </path>

    <!-- The classpath with only the jars available in the plugin folder of Eclipse -->
    <path id="Lab3_M2T_Almustafa.libraryclasspath.alljars">
        <pathelement location="../Lab3_M2T_Almustafa/bin"/>
        <fileset dir="${ECLIPSE_HOME}/plugins/" includes="*.jar"/>
    </path>

    <path id="Lab3_M2T_Almustafa.classpath.alljars">
        <path refid="Lab3_M2T_Almustafa.libraryclasspath.alljars"/>
    </path>

    <!-- The default task with the jars used by this project -->
    <target name="generate">
        <java classname="Lab3_M2T_Almustafa.main.Generate" classpathref="Lab3_M2T_Almustafa.classpath">
            <arg value="${model}"/>
            <arg value="${target}"/>
        </java>
    </target>

    <!--
        In case of problem you can also try with all the jar available in your Eclipse
        Keep in mind that having two versions of the same jar can create problems
    -->
    <target name="generate.alljars">
        <java classname="Lab3_M2T_Almustafa.main.Generate" classpathref="Lab3_M2T_Almustafa.classpath">
            <arg value="${model}"/>
            <arg value="${target}"/>
        </java>
    </target>
</project>
